{
  "name": "bun-p2p",
  "version": "1.0.0",
  "description": "Zero-relay, E2EE real-time terminal pair-programming and file streaming over WebRTC DataChannels using Bun and TypeScript",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "bun-p2p": "./bin/bun-p2p.js",
    "vtx": "./bin/bun-p2p.js",
    "vortex-auto": "./bin/bun-p2p.js"
  },
  "scripts": {
    "start": "bun run ./bin/bun-p2p.js",
    "test": "bun test",
    "build": "bun build src/index.ts --target=bun --outfile=dist/bun-p2p.js",
    "compile": "bun build src/index.ts --compile --outfile=dist/bun-p2p"
  },
  "keywords": [
    "bun",
    "webrtc",
    "datachannel",
    "p2p",
    "terminal",
    "pty",
    "pair-programming",
    "file-transfer",
    "e2ee",
    "cli",
    "wizard"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "node-datachannel": "^0.33.1",
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
